# Supabase — keep using the same project, just talking to it from your VPS
SUPABASE_URL="https://your-project-id.supabase.co"
# Service role key (Project Settings > API) — bypasses RLS, server-side only, never expose it
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# JWT secret (Project Settings > API > JWT Settings) — used to verify the frontend's login token
SUPABASE_JWT_SECRET="your-jwt-secret"

# EvolutionGo (or Evolution API) instance running on your VPS
EVOLUTION_BASE_URL="http://evolution:8080"
EVOLUTION_API_KEY="your-evolution-global-api-key"

# Public HTTPS URL this bridge is reachable at (used to register webhooks)
BRIDGE_PUBLIC_URL="https://whatsapp.seudominio.com.br"

PORT=3300

# Cron expression for the daily "come back" reminder job (default: 09:00 every day)
FOLLOWUP_CRON_SCHEDULE="0 9 * * *"
